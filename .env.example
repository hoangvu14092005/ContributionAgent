# ============================================================================
# GitHub Configuration
# ============================================================================
# 
# Tạo GitHub Personal Access Token tại:
# https://github.com/settings/tokens/new
#
# Quyền cần thiết (Required scopes):
# ✅ repo (full control)
# ✅ workflow (update workflows)
# ✅ read:org (read organization)
# ✅ read:user (read user profile)
# ✅ user:email (access email)
#
# Xem hướng dẫn chi tiết: docs/GITHUB_TOKEN_SETUP.md
#
GITHUB_TOKEN=ghp_your_github_token_here

# ============================================================================
# Custom Self-Hosted LLM Configuration
# ============================================================================
#
# Set provider to "custom" in config.yaml to use these settings
# Xem hướng dẫn chi tiết: docs/CUSTOM_LLM_SETUP.md

# Base URL for your self-hosted LLM endpoint (OpenAI-compatible API)
CUSTOM_LLM_BASE_URL=http://localhost:20128/v1

# API key for authentication (if required by your endpoint)
CUSTOM_LLM_API_KEY=your_api_key_here

# Model names for each task type
# These will be sent in the "model" field of the API request

# 1. Analysis - Code analysis and finding detection
LLM_MODEL_ANALYSIS=ag/gemini-3.1-pro-high

# 2. Code Generation - Generating fixes from findings
LLM_MODEL_CODE_GEN=gh/claude-sonnet-4.6

# 3. Review - Self-review of generated code
LLM_MODEL_REVIEW=cx/gpt-5.4

# 4. Validation - Validating findings to filter false positives
LLM_MODEL_VALIDATION=kr/claude-sonnet-4.5

# 5. Issue Solver - Solving GitHub issues
LLM_MODEL_ISSUE_SOLVER=gh/claude-sonnet-4.6

# 6. Context Compression - Compressing context to fit token limits
LLM_MODEL_COMPRESSION=gh/claude-sonnet-4.6

# 7. Default - Các thao tác khác không được định nghĩa cụ thể
LLM_MODEL_DEFAULT=gh/claude-sonnet-4.6

# ============================================================================
# Alternative LLM Providers (if not using custom)
# ============================================================================
#
# Gemini (Google AI)
# Tạo API key tại: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key
#
# OpenAI
# Tạo API key tại: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key
#
# Anthropic (Claude)
# Tạo API key tại: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_key

# ============================================================================
# Vertex AI (Google Cloud)
# ============================================================================
#
# Nếu dùng Vertex AI thay vì Gemini API key
# GOOGLE_CLOUD_PROJECT=your_project_id
